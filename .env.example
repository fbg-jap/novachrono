# ============================================================
# Novachrono
# ============================================================

# UI language.
# Supported values:
#   de_DE
#   en_US
NOVACHRONO_LOCALE=de_DE

# Timezone used for date, time, and weather data.
# Use an IANA timezone name, for example:
#   Europe/Berlin
NOVACHRONO_TIMEZONE=Europe/Berlin

# Temperature unit.
# Supported values:
#   C
#   F
NOVACHRONO_TEMPERATURE_UNIT=C


# ============================================================
# Weather
# ============================================================

# Weather location as WGS84 decimal coordinates.
NOVACHRONO_WEATHER_LATITUDE=
NOVACHRONO_WEATHER_LONGITUDE=


# ============================================================
# Mail Notifications
# ============================================================

# IMAP connection for the unread-mail notifications widget.
# Leave host, username, and password empty to disable the widget.
NOVACHRONO_MAIL_HOST=
NOVACHRONO_MAIL_PORT=993
NOVACHRONO_MAIL_USERNAME=
NOVACHRONO_MAIL_PASSWORD=

# Mailbox to check for unread mail.
NOVACHRONO_MAIL_MAILBOX=INBOX


# ============================================================
# Microsoft Teams Notifications
# ============================================================

# Microsoft Graph app-only (client credentials) connection for the Teams
# notifications widget, showing the latest message in one channel.
# Leave all five fields empty to disable the widget.
#
# Requires an Azure AD app registration with the Microsoft Graph
# Application permission "ChannelMessage.Read.All", admin-consented.
# See the README for setup details.
NOVACHRONO_TEAMS_TENANT_ID=
NOVACHRONO_TEAMS_CLIENT_ID=
NOVACHRONO_TEAMS_CLIENT_SECRET=
NOVACHRONO_TEAMS_TEAM_ID=
NOVACHRONO_TEAMS_CHANNEL_ID=


# ============================================================
# Divoom Times Gate
# ============================================================

# Local IP address or hostname.
# Do not include http:// or https://.
NOVACHRONO_TIMES_GATE_HOST=192.168.1.100

# Local API token.
NOVACHRONO_TIMES_GATE_TOKEN=replace-me
